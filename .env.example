# Copy to .env.local when integrating a real backend. None of these are used by the prototype.

# Base URL of the Java Spring Boot REST API (future)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Supabase is expected to sit behind the Spring Boot API (PostgreSQL).
# Never put service-role keys in a frontend env file. Only a public anon key,
# and only if the browser ever talks to Supabase directly (e.g. Storage uploads).
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
